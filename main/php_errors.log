                LEFT JOIN requests r ON t.request_id = r.request_id
                LEFT JOIN users u ON r.user_id = u.user_id
                LEFT JOIN request_statuses rs ON t.status_id = rs.status_id
                ORDER BY t.payment_date DESC
                LIMIT :offset, :per_page
